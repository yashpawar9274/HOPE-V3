<?xml version="1.0" encoding="utf-8"?>
<!-- iPhone-style call banner used by the incoming and ongoing call notifications. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/ios_call_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_ios_avatar"
        android:gravity="center"
        android:text="#"
        android:textColor="#FFFFFF"
        android:textSize="19sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/ios_call_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ios_call_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp" />

        <Chronometer
            android:id="@+id/ios_call_chrono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ios_call_decline"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_ios_circle_red"
        android:contentDescription="Decline"
        android:padding="10dp"
        android:src="@drawable/ic_ios_call_end" />

    <ImageView
        android:id="@+id/ios_call_accept"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_ios_circle_green"
        android:contentDescription="Accept"
        android:padding="10dp"
        android:src="@drawable/ic_ios_call" />
</LinearLayout>
