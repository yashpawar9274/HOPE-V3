<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <WebView
        android:id="@+id/orbView"
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:background="@android:color/transparent" />

    <TextView
        android:id="@+id/gateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="HOPE AI"
        android:textColor="@color/hope_auth_text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gateStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="Checking your licence\u2026"
        android:textColor="@color/hope_auth_text_muted"
        android:textSize="15sp" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/gateProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:indeterminate="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/gateRetry"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Try again"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/gateSignOut"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sign out"
        android:visibility="gone" />
</LinearLayout>
